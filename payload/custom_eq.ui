<ui>
  <values id="cfw_eq_types">
    <value number="0" label="Off"/>
    <value number="1" label="Peaking"/>
    <value number="2" label="Low shelf"/>
    <value number="3" label="High shelf"/>
  </values>
  <values id="cfw_eq_frequencies">
    <value number="20" label="20 Hz"/>
    <value number="25" label="25 Hz"/>
    <value number="31" label="31 Hz"/>
    <value number="40" label="40 Hz"/>
    <value number="50" label="50 Hz"/>
    <value number="60" label="60 Hz"/>
    <value number="70" label="70 Hz"/>
    <value number="80" label="80 Hz"/>
    <value number="100" label="100 Hz"/>
    <value number="125" label="125 Hz"/>
    <value number="160" label="160 Hz"/>
    <value number="200" label="200 Hz"/>
    <value number="250" label="250 Hz"/>
    <value number="315" label="315 Hz"/>
    <value number="400" label="400 Hz"/>
    <value number="500" label="500 Hz"/>
    <value number="630" label="630 Hz"/>
    <value number="800" label="800 Hz"/>
    <value number="1000" label="1000 Hz"/>
    <value number="1250" label="1250 Hz"/>
    <value number="1600" label="1600 Hz"/>
    <value number="2000" label="2000 Hz"/>
    <value number="2500" label="2500 Hz"/>
    <value number="3150" label="3150 Hz"/>
    <value number="4000" label="4000 Hz"/>
    <value number="5000" label="5000 Hz"/>
    <value number="6300" label="6300 Hz"/>
    <value number="8000" label="8000 Hz"/>
    <value number="10000" label="10000 Hz"/>
    <value number="12500" label="12500 Hz"/>
    <value number="16000" label="16000 Hz"/>
    <value number="20000" label="20000 Hz"/>
  </values>
  <range id="cfw_eq_precut_values" first="0" last="-100" step="-5" scale="10" suffix=" dB"/>
  <range id="cfw_eq_q" first="3" last="40" step="1" scale="10"/>
  <range id="cfw_eq_gain" first="-120" last="120" step="5" scale="10" suffix=" dB" signed="true"/>
  <values id="cfw_eq_save_status">
    <value number="0" label="Save settings"/>
    <value number="1" label="Save failed - retry"/>
    <value number="2" label="Invalid filter settings"/>
  </values>

  <!-- Slots and choice order are part of the version-1 saved EQ settings format. -->
  <menu id="CFW_EQ" title="Custom EQ">
    <selector id="CFW_EQ_Precut" title="Precut" values="cfw_eq_precut_values" slot="0" default="0"/>
    <menu id="CFW_EQ_Band1" title="Band 1">
      <selector id="CFW_EQ_Band1_Type" title="Type" values="cfw_eq_types" slot="1" default="2"/>
      <selector id="CFW_EQ_Band1_Frequency" title="Frequency" values="cfw_eq_frequencies" slot="2" default="60"/>
      <selector id="CFW_EQ_Band1_Q" title="Q" values="cfw_eq_q" slot="3" default="7"/>
      <selector id="CFW_EQ_Band1_Gain" title="Gain" values="cfw_eq_gain" slot="4" default="0"/>
    </menu>
    <menu id="CFW_EQ_Band2" title="Band 2">
      <selector id="CFW_EQ_Band2_Type" title="Type" values="cfw_eq_types" slot="5" default="1"/>
      <selector id="CFW_EQ_Band2_Frequency" title="Frequency" values="cfw_eq_frequencies" slot="6" default="1000"/>
      <selector id="CFW_EQ_Band2_Q" title="Q" values="cfw_eq_q" slot="7" default="7"/>
      <selector id="CFW_EQ_Band2_Gain" title="Gain" values="cfw_eq_gain" slot="8" default="0"/>
    </menu>
    <menu id="CFW_EQ_Band3" title="Band 3">
      <selector id="CFW_EQ_Band3_Type" title="Type" values="cfw_eq_types" slot="9" default="3"/>
      <selector id="CFW_EQ_Band3_Frequency" title="Frequency" values="cfw_eq_frequencies" slot="10" default="8000"/>
      <selector id="CFW_EQ_Band3_Q" title="Q" values="cfw_eq_q" slot="11" default="7"/>
      <selector id="CFW_EQ_Band3_Gain" title="Gain" values="cfw_eq_gain" slot="12" default="0"/>
    </menu>
    <action id="CFW_EQ_Save" title="Save settings" values="cfw_eq_save_status"/>
  </menu>
  <settings-entry menu="CFW_EQ" after="SettingsMenu_ListItem_EQ" open="CFW_EQ_Open"/>
  <string id="CFW_EQ_PRESET_NAME" text="Custom"/>
</ui>
