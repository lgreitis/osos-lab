<ui>
  <list id="CFW_Theme" title="Theme" controller="CFWTheme"/>
  <bitmap id="CFW_Theme_Icon" file="assets/settings-theme.png" format="gray4"/>
  <settings-entry menu="CFW_Theme" after="SettingsMenu_ListItem_Brightness"
                  open="CFW_Theme_Open" preview="image" image="CFW_Theme_Icon"/>
  <screen-controller screen="SettingsMenus_Main_Screen" controller="CFWSettingsMain"/>
</ui>
