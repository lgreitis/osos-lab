diff --git a/bootloader/cfw-file-ipod6g.c b/bootloader/cfw-file-ipod6g.c
new file mode 100644
index 0000000000..9f9f4e463e
--- /dev/null
+++ b/bootloader/cfw-file-ipod6g.c
@@ -0,0 +1,146 @@
+/* Load CFW files and enter the companion's ARM bootstrap.
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#include "config.h"
+#include "system.h"
+#include "s5l87xx.h"
+#include "cfw-target.h"
+#include "gpio-s5l8702.h"
+#include "file.h"
+#include "kernel.h"
+#include "lcd.h"
+#include "common.h"
+#include "storage.h"
+#include "hfsplus/reader.c"
+#include "string.h"
+
+static unsigned char io_buffer[16384] CACHEALIGN_ATTR;
+
+static void stop(const char *message) __attribute__((noreturn));
+static void stop(const char *message)
+{
+    printf("%s", message);
+    printf("Menu+Select to restart");
+    while (1) sleep(HZ);
+}
+
+/* Copy through the uncached alias after each synchronous DMA-backed read. */
+static uint32_t load_file(const char *path, uint32_t destination,
+                          uint32_t minimum, uint32_t capacity)
+{
+    int fd = open(path, O_RDONLY);
+    if (fd < 0) {
+        printf("Missing %s", path);
+        stop("File open failed");
+    }
+    off_t size = filesize(fd);
+    if (size < (off_t)minimum || size > (off_t)capacity) {
+        close(fd);
+        stop("File size out of bounds");
+    }
+    uint32_t position = 0;
+    unsigned char *out = S5L8702_UNCACHED_ADDR((void *)destination);
+    while (position < (uint32_t)size) {
+        uint32_t count = (uint32_t)size - position;
+        if (count > sizeof(io_buffer)) count = sizeof(io_buffer);
+        ssize_t got = read(fd, io_buffer, count);
+        if (got <= 0 || (uint32_t)got > count) {
+            close(fd);
+            stop("File read failed");
+        }
+        memcpy(out + position, io_buffer, got);
+        position += got;
+    }
+    if (close(fd) < 0)
+        stop("File close failed");
+    return position;
+}
+
+static unsigned char node_scratch[32768];
+static bool read_bytes(void *context, uint64_t offset, void *dst, size_t length)
+{
+    const struct storage_info *info = context;
+    unsigned shift = info->sector_size == 4096 ? 12 : 9;
+    unsigned mask = info->sector_size - 1;
+    unsigned char *out = dst;
+    while (length) {
+        unsigned skip = offset & mask;
+        size_t chunk = MIN(length, sizeof(io_buffer) - skip);
+        int sectors = (skip + chunk + mask) >> shift;
+        if (storage_read_sectors(IF_MD(0,) offset >> shift, sectors, io_buffer))
+            return false;
+        memcpy(out, io_buffer + skip, chunk);
+        offset += chunk;
+        out += chunk;
+        length -= chunk;
+    }
+    return true;
+}
+
+static struct storage_info hfs_info;
+static struct hfs_disk hfs_disk = {read_bytes, &hfs_info, 0};
+
+/* Volumes Apple's firmware did not unmount cleanly are read as stored. */
+static uint32_t load_hfs_file(const char *path, uint32_t destination,
+                              uint32_t minimum, uint32_t capacity)
+{
+    size_t length;
+    enum hfs_result rc = hfs_read_path(&hfs_disk, path,
+        S5L8702_UNCACHED_ADDR((void *)destination), capacity, &length,
+        node_scratch, sizeof(node_scratch));
+    if (rc == HFS_NOT_FOUND) {
+        printf("Missing %s", path);
+        stop("File open failed");
+    }
+    if (rc == HFS_TOO_LARGE)
+        stop("File size out of bounds");
+    if (rc != HFS_OK) {
+        printf("HFS+ error %d", (int)rc);
+        stop(path);
+    }
+    if (length < minimum)
+        stop("File size out of bounds");
+    return length;
+}
+
+/* hfs: no FAT volume mounted. Returns when the disk holds no HFS+ volume either. */
+void cfw_run_file(bool hfs)
+{
+    if (hfs) {
+        storage_get_info(0, &hfs_info);
+        if (hfs_info.sector_size != 512 && hfs_info.sector_size != 4096)
+            return;
+        hfs_disk.bytes = (uint64_t)hfs_info.sector_size * hfs_info.num_sectors;
+        struct hfs_volume volume;
+        if (hfs_open(&volume, &hfs_disk) == HFS_NOT_FOUND)
+            return;
+    }
+
+    uint32_t (*load)(const char *, uint32_t, uint32_t, uint32_t) =
+        hfs ? load_hfs_file : load_file;
+    printf("Loading /Reprise/Firmware/reprise.bin");
+    uint32_t osos_bytes = load("/Reprise/Firmware/reprise.bin", CFW_STAGE_START,
+                               1, CFW_COMPANION_START - CFW_STAGE_START);
+    printf("Loading /Reprise/Firmware/loader.bin");
+    uint32_t companion_bytes = load("/Reprise/Firmware/loader.bin", CFW_COMPANION_START,
+                                    CFW_BOOTSTRAP_BYTES,
+                                    CFW_STAGE_END - CFW_COMPANION_START);
+    const void *companion = S5L8702_UNCACHED_ADDR((void *)CFW_COMPANION_START);
+    printf("Booting CFW...");
+
+    /* Drain display DMA before transferring control with interrupts masked. */
+    lcd_shutdown();
+    disable_irq();
+    disable_fiq();
+    ATA_IRQ_MASK = 0;
+    ATA_IRQ = ATA_IRQ;
+    eint_init();
+    memcpy((void *)IRAM0_ORIG, companion, CFW_BOOTSTRAP_BYTES);
+    commit_discard_idcache();
+
+    /* r0/r1: firmware address/length; r2/r3: companion address/length. */
+    typedef void (*entry_fn)(uint32_t, uint32_t, uint32_t, uint32_t);
+    ((entry_fn)IRAM0_ORIG)(CFW_STAGE_START, osos_bytes,
+                         CFW_COMPANION_START, companion_bytes);
+    while (1);
+}
diff --git a/firmware/target/arm/s5l8702/cfw-target.h b/firmware/target/arm/s5l8702/cfw-target.h
new file mode 100644
index 0000000000..84e5d67983
--- /dev/null
+++ b/firmware/target/arm/s5l8702/cfw-target.h
@@ -0,0 +1,14 @@
+/* Classic CFW transport layout. SPDX-License-Identifier: GPL-2.0-or-later */
+#ifndef CFW_TARGET_H
+#define CFW_TARGET_H
+
+#if !defined(IPOD_6G) || !defined(BOOTLOADER) || MEMORYSIZE != 64
+#error CFW file boot requires the 64 MiB Classic bootloader
+#endif
+
+#define CFW_STAGE_START (DRAM_ORIG + 0x03000000)
+#define CFW_STAGE_END   TTB_BASE_ADDR
+#define CFW_COMPANION_START (DRAM_ORIG + 0x03c00000)
+#define CFW_BOOTSTRAP_BYTES 0x1f800
+
+#endif
